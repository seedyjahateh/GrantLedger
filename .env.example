# Institution values: copy to a private .env; never commit real credentials.
DATABASE_URL=jdbc:postgresql://db.internal:5432/grantledger
DATABASE_USER=grantledger_app
DATABASE_PASSWORD=replace-through-secret-store
RUN_MIGRATIONS=false
OIDC_ISSUER=https://identity.university.example/realms/university
OIDC_AUDIENCE=grantledger-api
OIDC_CLIENT_ID=grantledger-web
OIDC_CLIENT_SECRET=replace-through-secret-store
OIDC_AUTH_URI=https://identity.university.example/realms/university/protocol/openid-connect/auth
OIDC_TOKEN_URI=https://identity.university.example/realms/university/protocol/openid-connect/token
OIDC_JWK_URI=https://identity.university.example/realms/university/protocol/openid-connect/certs
OIDC_USERINFO_URI=https://identity.university.example/realms/university/protocol/openid-connect/userinfo
COOKIE_SECURE=true
INSTITUTION_TIMEZONE=America/New_York
